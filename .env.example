# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from your sandbox app (after you add the webhook URL). Needed to verify webhook signatures.
PAYPAL_WEBHOOK_ID=

# --- AI model: any OpenAI-compatible chat completions endpoint with tool calling ---
# OpenAI:    https://api.openai.com/v1   (model e.g. gpt-4.1-mini)
# Anthropic: https://api.anthropic.com/v1 (OpenAI-compatible layer; model e.g. claude-sonnet-4-5)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# --- App ---
PORT=3000
DEMO_MODE=1
# Comma-separated emails of 4 sandbox PERSONAL accounts (used by the demo circle). Payouts go to these.
DEMO_EMAILS=
DB_PATH=susu.db
